{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Lotus Documentation",
  "colors": {
    "primary": "#CCFF00",
    "light": "#CCFF00",
    "dark": "#87a900"
  },
  "favicon": {
    "light": "/images/Frame2lotus.png",
    "dark": "/images/Frame1lotus.png"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/Frame2lotus.png",
    "dark": "/images/Frame1lotus.png",
    "href": "https://uselotus.xyz"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hi@uselotus.xyz"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/uselotusxyz",
      "website": "https://uselotus.xyz",
      "telegram": "https://t.me/uselotusxyz"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "family": "Inter",
    "weight": 400
  },
  "description": "Lotus is building the execution layer for prediction markets. We are building the infrastructure that allows traders access better execution, liquidity, market aggregation, matching. Our infra goes a step further to allow RFQs and a private liquidity backstop."
}
